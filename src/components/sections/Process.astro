---
// src/components/sections/Process.astro
import { translations } from "../../i18n/translations";

const lang = Astro.url.pathname.startsWith("/en") ? "en" : "es";
const t = translations[lang];
const p = t.process;

// Íconos SVG para cada paso (mismo orden que steps en translations)
const icons = [
  // 01 Descubrimiento — conversación
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`,
  // 02 Diagnóstico — lupa
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>`,
  // 03 Propuesta — documento
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
  // 04 Planificación — calendario
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`,
  // 05 Diseño — lápiz en cuadrado
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>`,
  // 06 Desarrollo — código
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
  // 07 QA — shield check
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  // 08 Lanzamiento — cohete
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.82m5.84-2.56a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.82m2.56-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/></svg>`,
  // 09 Soporte — corazón con pulso
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
];

// Colores progresivos para los números: de violeta a turquesa
const stepColors = [
  "#5B4DFF", // 01
  "#6A5BFF", // 02
  "#4F6EF7", // 03
  "#3D80EF", // 04
  "#2F80ED", // 05
  "#2E96D8", // 06
  "#2DADC4", // 07
  "#2DC4B0", // 08
  "#2DD4BF", // 09
];
---

<section id="proceso" class="relative py-24 lg:py-32 bg-deep overflow-hidden">

  <!-- Ruido/textura sutil de fondo -->
  <div class="absolute inset-0 process-noise pointer-events-none opacity-30"></div>

  <!-- Destellos de color de fondo -->
  <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96
              bg-primary/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-80 h-80
              bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative container mx-auto px-6">

    <!-- ===== ENCABEZADO ===== -->
    <div class="flex flex-col items-center text-center mb-20 space-y-5">

      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full
                   bg-surface/10 border border-surface/20
                   text-surface/80 text-sm font-semibold">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        {p.badge}
      </span>

      <h2 class="text-4xl lg:text-5xl font-extrabold text-surface leading-tight tracking-tight max-w-2xl">
        {p.title}
      </h2>

      <p class="text-lg text-surface/60 max-w-xl leading-relaxed">
        {p.subtitle}
      </p>

    </div>

    <!-- ===== LÍNEA DE TIEMPO ===== -->
    <!--
      Desktop: 5 pasos en fila 1 + 4 pasos en fila 2 (zigzag visual)
      Móvil: columna única con línea vertical a la izquierda
    -->

    <!-- FILA 1: pasos 01-05 -->
    <div class="relative mb-6">

      <!-- Línea horizontal conectora (solo desktop) -->
      <div class="absolute top-8 left-[10%] right-[10%] h-px
                  bg-gradient-to-r from-primary via-secondary to-accent
                  hidden lg:block opacity-40">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {p.steps.slice(0, 5).map((step, i) => (
          <div class="relative flex flex-col items-center text-center group">

            <!-- Nodo de la línea de tiempo -->
            <div class="relative mb-5 z-10">
              <!-- Anillo exterior pulsante -->
              <div
                class="absolute inset-0 rounded-full opacity-0 group-hover:opacity-100
                       transition-opacity duration-500 scale-150"
                style={`background: radial-gradient(circle, ${stepColors[i]}30, transparent 70%)`}
              ></div>
              <!-- Círculo principal -->
              <div
                class="w-16 h-16 rounded-full flex items-center justify-center
                       border-2 transition-all duration-300
                       group-hover:scale-110 group-hover:shadow-lg"
                style={`
                  background-color: ${stepColors[i]}18;
                  border-color: ${stepColors[i]}50;
                  color: ${stepColors[i]};
                  box-shadow: group-hover ? 0 0 20px ${stepColors[i]}40 : none;
                `}
              >
                <Fragment set:html={icons[i]} />
              </div>
            </div>

            <!-- Número -->
            <span
              class="text-xs font-bold tracking-[0.2em] mb-1.5"
              style={`color: ${stepColors[i]}90`}
            >
              {step.number}
            </span>

            <!-- Título -->
            <h3 class="text-base font-bold text-surface mb-2
                       group-hover:text-primary transition-colors duration-300"
                style={`--hover-color: ${stepColors[i]}`}>
              {step.title}
            </h3>

            <!-- Descripción -->
            <p class="text-sm text-surface/50 leading-relaxed">
              {step.description}
            </p>

          </div>
        ))}
      </div>
    </div>

    <!-- Conector entre filas (solo desktop) -->
    <div class="hidden lg:flex justify-end pr-[10%] mb-6">
      <div class="flex items-center gap-2 text-surface/20">
        <div class="w-24 h-px bg-gradient-to-r from-accent to-transparent"></div>
        <svg class="w-4 h-4 rotate-90 text-accent/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>
    </div>

    <!-- FILA 2: pasos 06-09 (centrados en desktop) -->
    <div class="relative">

      <!-- Línea horizontal conectora fila 2 (solo desktop) -->
      <div class="absolute top-8 left-[17%] right-[17%] h-px
                  bg-gradient-to-r from-secondary to-accent
                  hidden lg:block opacity-40">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:px-16">
        {p.steps.slice(5, 9).map((step, i) => {
          const idx = i + 5;
          return (
            <div class="relative flex flex-col items-center text-center group">

              <!-- Nodo -->
              <div class="relative mb-5 z-10">
                <div
                  class="absolute inset-0 rounded-full opacity-0 group-hover:opacity-100
                         transition-opacity duration-500 scale-150"
                  style={`background: radial-gradient(circle, ${stepColors[idx]}30, transparent 70%)`}
                ></div>
                <div
                  class="w-16 h-16 rounded-full flex items-center justify-center
                         border-2 transition-all duration-300
                         group-hover:scale-110"
                  style={`
                    background-color: ${stepColors[idx]}18;
                    border-color: ${stepColors[idx]}50;
                    color: ${stepColors[idx]};
                  `}
                >
                  <Fragment set:html={icons[idx]} />
                </div>
              </div>

              <!-- Número -->
              <span
                class="text-xs font-bold tracking-[0.2em] mb-1.5"
                style={`color: ${stepColors[idx]}90`}
              >
                {step.number}
              </span>

              <!-- Título -->
              <h3 class="text-base font-bold text-surface mb-2
                         transition-colors duration-300">
                {step.title}
              </h3>

              <!-- Descripción -->
              <p class="text-sm text-surface/50 leading-relaxed">
                {step.description}
              </p>

            </div>
          );
        })}
      </div>
    </div>

    <!-- ===== CTA INFERIOR ===== -->
    <div class="mt-20 flex flex-col items-center gap-5 text-center">
      <p class="text-surface/50 text-base">
        {lang === "es"
          ? "¿Listo para iniciar tu proyecto con nosotros?"
          : "Ready to start your project with us?"}
      </p>
      <a
        href="/#contacto"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl
               bg-primary hover:bg-primary/85
               text-white text-sm font-semibold
               shadow-lg shadow-primary/30
               transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
      >
        {lang === "es" ? "Iniciar mi proyecto" : "Start my project"}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  /* Patrón de ruido sutil sobre el fondo oscuro */
  .process-noise {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.4'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 200px 200px;
  }
</style>
