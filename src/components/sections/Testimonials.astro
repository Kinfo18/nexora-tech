---
// src/components/sections/Testimonials.astro
import { translations } from "../../i18n/translations";

const lang = Astro.url.pathname.startsWith("/en") ? "en" : "es";
const t = translations[lang];
const test = t.testimonials;
---

<section id="testimonios" class="relative py-24 lg:py-32 bg-deep overflow-hidden">

  <!-- Destellos de fondo -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[350px]
              bg-gradient-to-b from-primary/20 to-transparent
              rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[400px] h-[300px]
              bg-gradient-to-tl from-accent/15 to-transparent
              rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative container mx-auto px-6">

    <!-- ENCABEZADO -->
    <div class="flex flex-col items-center text-center mb-16 space-y-5">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full
                   bg-surface/10 border border-surface/20
                   text-surface/80 text-sm font-semibold">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
        </svg>
        {test.badge}
      </span>

      <h2 class="text-4xl lg:text-5xl font-extrabold text-surface
                 leading-tight tracking-tight max-w-2xl">
        {test.title}
      </h2>

      <p class="text-lg text-surface/60 max-w-xl leading-relaxed">
        {test.subtitle}
      </p>
    </div>

    <!-- TARJETAS GLASSMORPHISM -->
    <!--
      Estructura preparada para slider futuro:
      data-testimonials-container + data-slide por tarjeta
      Solo agregar Swiper/Embla en el futuro sin cambiar el HTML
    -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7"
      data-testimonials-container
    >
      {test.items.map((item) => (
        <div
          class="testimonial-card relative flex flex-col
                 rounded-2xl p-8
                 border border-surface/10
                 hover:border-surface/20
                 transition-all duration-300
                 hover:-translate-y-1 hover:shadow-2xl"
          style="background: rgba(255,255,255,0.04); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);"
          data-slide
        >

          <!-- Comillas decorativas -->
          <div class="absolute top-6 right-7 text-6xl font-serif leading-none
                      text-surface/8 select-none pointer-events-none">
            &ldquo;
          </div>

          <!-- Estrellas -->
          <div class="flex gap-1 mb-5">
            {Array.from({ length: item.stars }).map(() => (
              <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <p class="text-surface/80 text-base leading-relaxed flex-1 mb-7 relative z-10">
            &ldquo;{item.quote}&rdquo;
          </p>

          <!-- Divider -->
          <div class="w-full h-px bg-surface/10 mb-6"></div>

          <!-- Avatar + info -->
          <div class="flex items-center gap-4">
            <!-- Avatar con iniciales y color del proyecto -->
            <div
              class="w-11 h-11 rounded-full flex items-center justify-center
                     text-white text-sm font-bold shrink-0"
              style={`background: linear-gradient(135deg, ${item.avatarColor}, ${item.avatarColor}99)`}
            >
              {item.initials}
            </div>

            <div>
              <p class="text-surface font-bold text-sm">{item.name}</p>
              <p class="text-surface/50 text-xs mt-0.5">
                {item.role} &middot; {item.company}
              </p>
            </div>

            <!-- Logo/badge de empresa -->
            <div class="ml-auto">
              <span
                class="px-2.5 py-1 rounded-lg text-xs font-semibold"
                style={`background: ${item.avatarColor}20; color: ${item.avatarColor}`}
              >
                {item.company}
              </span>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Indicador de slider futuro (dots) -->
    <div class="flex justify-center gap-2 mt-10" aria-hidden="true">
      {test.items.map((_, i) => (
        <div class={`h-1.5 rounded-full transition-all duration-300 ${
          i === 0 ? "w-6 bg-primary" : "w-1.5 bg-surface/20"
        }`}></div>
      ))}
    </div>

  </div>
</section>
