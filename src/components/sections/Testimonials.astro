---
import { translations } from "../../i18n/translations";
const lang = Astro.url.pathname.startsWith("/en") ? "en" : "es";
const t = translations[lang];
const tm = t.testimonials;
---

<section id="testimonios" class="relative py-24 overflow-hidden bg-[#0D0F1A]">

  <!-- Glows de fondo -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">

    <!-- Encabezado -->
    <div class="reveal reveal-fade-up text-center mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full
                   bg-primary/15 border border-primary/25 text-primary text-sm font-semibold mb-4">
        {tm.badge}
      </span>
      <h2 class="text-4xl lg:text-5xl font-extrabold text-surface leading-tight mb-4">{tm.title}</h2>
      <p class="text-lg text-surface/60 max-w-2xl mx-auto">{tm.subtitle}</p>
    </div>

    <!-- Grid de testimonios -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-testimonials-container>
      {tm.items.map((item, i) => (
        <div
          class="reveal reveal-fade-up relative p-8 rounded-2xl flex flex-col gap-5
                 bg-white/4 border border-white/10
                 hover:-translate-y-1 hover:border-white/20
                 hover:shadow-2xl transition-all duration-300
                 backdrop-blur-sm"
          data-delay={String(i * 150) as any}
          data-slide={i}
        >
          <!-- Comillas decorativas -->
          <span class="absolute top-4 right-6 text-7xl font-serif leading-none
                       text-white/8 pointer-events-none select-none">&ldquo;</span>

          <!-- Estrellas -->
          <div class="flex items-center gap-0.5">
            {Array.from({ length: item.stars }).map(() => (
              <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Cita -->
          <p class="text-surface/80 text-sm leading-relaxed flex-1 italic">&ldquo;{item.quote}&rdquo;</p>

          <!-- Footer: avatar + nombre -->
          <div class="flex items-center justify-between pt-4 border-t border-white/10">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-white shrink-0"
                   style={`background: linear-gradient(135deg, ${item.avatarColor}, ${item.avatarColor}99)`}>
                {item.initials}
              </div>
              <div>
                <p class="text-surface font-semibold text-sm">{item.name}</p>
                <p class="text-surface/50 text-xs">{item.role}</p>
              </div>
            </div>
            <span class="text-xs font-semibold px-3 py-1 rounded-full"
                  style={`background:${item.avatarColor}20; color:${item.avatarColor}`}>
              {item.company}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
