---
import { translations } from "../../i18n/translations";
const lang = Astro.url.pathname.startsWith("/en") ? "en" : "es";
const t = translations[lang];
const a = t.about;
---

<section id="nosotros" class="py-24 bg-white dark:bg-[#0D0F1A] overflow-hidden">
  <div class="container mx-auto px-6">

    <!-- Badge + Título -->
    <div class="reveal reveal-fade-up text-center mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full
                   bg-primary/10 border border-primary/20 text-primary text-sm font-semibold mb-4">
        {a.badge}
      </span>
      <h2 class="text-4xl lg:text-5xl font-extrabold text-dark dark:text-surface leading-tight tracking-tight mb-4">
        {a.title}
      </h2>
      <p class="text-lg text-dark/60 dark:text-surface/60 max-w-2xl mx-auto">{a.description}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Columna izquierda: diferenciadores -->
      <div class="reveal reveal-fade-left">
        <ul class="space-y-4 mb-10">
          {a.differentiators.map((item, i) => (
            <li class="reveal reveal-fade-left flex items-start gap-3" data-delay={String(i * 100) as any}>
              <span class="mt-1 w-5 h-5 rounded-full bg-primary/15 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                </svg>
              </span>
              <span class="text-dark/80 dark:text-surface/80 font-medium">{item}</span>
            </li>
          ))}
        </ul>
        <!-- Ubicación -->
        <div class="flex flex-col gap-2 text-sm text-dark/50 dark:text-surface/50">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            {a.location}
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/>
            </svg>
            {a.coverage}
          </span>
        </div>
      </div>

      <!-- Columna derecha: misión + visión + stats -->
      <div class="space-y-6">
        <!-- Misión -->
        <div class="reveal reveal-fade-right p-6 rounded-2xl bg-primary/5 border border-primary/15">
          <h3 class="text-sm font-bold text-primary uppercase tracking-wider mb-2">{a.missionTitle}</h3>
          <p class="text-dark/70 dark:text-surface/70 text-sm leading-relaxed">{a.mission}</p>
        </div>
        <!-- Visión -->
        <div class="reveal reveal-fade-right p-6 rounded-2xl bg-accent/5 border border-accent/15" data-delay="150">
          <h3 class="text-sm font-bold text-accent uppercase tracking-wider mb-2">{a.visionTitle}</h3>
          <p class="text-dark/70 dark:text-surface/70 text-sm leading-relaxed">{a.vision}</p>
        </div>
        <!-- Stats -->
        <div class="reveal reveal-fade-right grid grid-cols-2 gap-4" data-delay="300">
          {a.stats.map((stat) => (
            <div class="p-5 rounded-2xl bg-surface dark:bg-white/5 border border-dark/8 dark:border-white/10 text-center">
              <p class="text-3xl font-extrabold text-primary mb-1">{stat.value}</p>
              <p class="text-xs text-dark/50 dark:text-surface/50 font-medium">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
