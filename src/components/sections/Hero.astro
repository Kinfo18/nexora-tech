---
// src/components/sections/Hero.astro
import Button from "../ui/Button.astro";
import { translations } from "../../i18n/translations";

const lang = Astro.url.pathname.startsWith("/en") ? "en" : "es";
const t = translations[lang];

const techs = [
  { name: "React",   color: "#61DAFB" },
  { name: "Next.js", color: "#A0A0A0" },
  { name: "Node.js", color: "#339933" },
  { name: "Python",  color: "#3776AB" },
  { name: "AWS",     color: "#FF9900" },
  { name: "Docker",  color: "#2496ED" },
];

const metrics = [
  { label: lang === "es" ? "Eficiencia operativa"   : "Operational efficiency",  value: 92, color: "bg-primary" },
  { label: lang === "es" ? "Proyectos completados"  : "Completed projects",       value: 78, color: "bg-secondary" },
  { label: lang === "es" ? "Satisfacción del cliente": "Client satisfaction",     value: 98, color: "bg-accent" },
];

const stats = [
  { value: "10+",   label: lang === "es" ? "Proyectos"    : "Projects" },
  { value: "100%",  label: lang === "es" ? "Satisfacción" : "Satisfaction" },
  { value: "5+",    label: lang === "es" ? "Años exp."    : "Years exp." },
  { value: "Latam", label: lang === "es" ? "Cobertura"    : "Coverage" },
];
---

<section
  id="inicio"
  class="relative min-h-screen flex flex-col justify-center overflow-hidden pt-28 pb-20 hero-gradient"
>
  <div class="container mx-auto px-6">

    <!-- GRID 2 COLUMNAS -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- COLUMNA IZQUIERDA -->
      <div class="flex flex-col items-start space-y-7">

        <!-- Badge de credibilidad -->
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full
                     bg-primary/10 dark:bg-primary/15
                     border border-primary/20 dark:border-primary/30
                     text-primary text-sm font-semibold">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
          </span>
          {t.hero.badge}
        </span>

        <!-- Título con gradiente en palabra clave -->
        <h1 class="text-5xl lg:text-6xl xl:text-7xl font-extrabold
                   text-dark dark:text-surface
                   leading-[1.1] tracking-tight">
          {lang === "es"
            ? <>{"Desarrollamos "}<span class="text-gradient">{"software"}</span>{" que impulsa el crecimiento de tu empresa"}</>
            : <>{"We build "}<span class="text-gradient">{"software"}</span>{" that drives your company's growth"}</>
          }
        </h1>

        <!-- Subtítulo -->
        <p class="text-lg lg:text-xl text-dark/65 dark:text-surface/65 max-w-xl leading-relaxed">
          {t.hero.subtitle}
        </p>

        <!-- Botones CTA -->
        <div class="flex flex-wrap gap-4 pt-2">
          <Button href="/contacto">{t.hero.ctaPrimary}</Button>
          <Button href="/#servicios" variant="ghost">{t.hero.ctaSecondary}</Button>
        </div>

      </div>

      <!-- COLUMNA DERECHA: Mockup dashboard -->
      <div class="relative group lg:pl-8">

        <!-- Halo de brillo -->
        <div class="absolute -inset-4 bg-gradient-to-r from-primary/20 via-secondary/15 to-accent/20
                    rounded-3xl blur-2xl opacity-60 dark:opacity-40
                    group-hover:opacity-80 transition-opacity duration-700">
        </div>

        <!-- Ventana mockup -->
        <div class="relative bg-white/95 dark:bg-deep/90
                    border border-dark/10 dark:border-surface/10
                    backdrop-blur-sm rounded-2xl shadow-2xl overflow-hidden">

          <!-- Barra título tipo macOS -->
          <div class="flex items-center justify-between px-5 py-3.5
                      bg-surface/80 dark:bg-surface/5
                      border-b border-dark/8 dark:border-surface/8">
            <div class="flex items-center gap-1.5">
              <div class="w-3 h-3 rounded-full bg-red-400"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
            </div>
            <span class="text-xs font-mono text-dark/40 dark:text-surface/40">nexora_dashboard.app</span>
            <div class="w-14"></div>
          </div>

          <!-- Contenido del dashboard -->
          <div class="p-6 space-y-6">

            <!-- Header del dashboard -->
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs font-medium text-dark/40 dark:text-surface/40 uppercase tracking-wider">
                  {lang === "es" ? "Rendimiento del proyecto" : "Project Performance"}
                </p>
                <p class="text-2xl font-bold text-dark dark:text-surface mt-0.5">Q1 2025</p>
              </div>
              <span class="px-3 py-1 rounded-full bg-accent/15 text-accent text-xs font-bold">↑ 35%</span>
            </div>

            <!-- Barras de progreso -->
            <div class="space-y-4">
              {metrics.map((metric) => (
                <div class="space-y-1.5">
                  <div class="flex justify-between items-center">
                    <span class="text-xs font-medium text-dark/60 dark:text-surface/60">{metric.label}</span>
                    <span class="text-xs font-bold text-dark dark:text-surface">{metric.value}%</span>
                  </div>
                  <div class="w-full bg-dark/8 dark:bg-surface/10 rounded-full h-2 overflow-hidden">
                    <div class={`${metric.color} h-full rounded-full`} style={`width: ${metric.value}%`} />
                  </div>
                </div>
              ))}
            </div>

            <!-- Grid de stats -->
            <div class="grid grid-cols-2 gap-3">
              {stats.map((stat) => (
                <div class="rounded-xl bg-surface/60 dark:bg-surface/5
                            border border-dark/8 dark:border-surface/8
                            p-3.5 text-center">
                  <p class="text-xl font-extrabold text-primary">{stat.value}</p>
                  <p class="text-xs text-dark/50 dark:text-surface/50 mt-0.5">{stat.label}</p>
                </div>
              ))}
            </div>

          </div>
        </div>

        <!-- Tarjeta flotante decorativa -->
        <div class="absolute -bottom-4 -left-4 lg:-left-8
                    bg-white dark:bg-deep
                    border border-dark/10 dark:border-surface/10
                    rounded-xl shadow-lg px-4 py-3
                    flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center shrink-0">
            <span class="text-accent text-sm font-bold">✓</span>
          </div>
          <div>
            <p class="text-xs font-bold text-dark dark:text-surface">
              {lang === "es" ? "Proyecto entregado" : "Project delivered"}
            </p>
            <p class="text-xs text-dark/50 dark:text-surface/50">
              {lang === "es" ? "hace 2 horas" : "2 hours ago"}
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- SECCIÓN DE TECNOLOGÍAS -->
    <div class="mt-24 pt-10 border-t border-dark/8 dark:border-surface/8">
      <p class="text-center text-xs font-semibold text-dark/40 dark:text-surface/40
                uppercase tracking-[0.2em] mb-10">
        {t.hero.techsLabel}
      </p>
      <div class="flex flex-wrap justify-center items-center gap-4 lg:gap-6">
        {techs.map((tech) => (
          <div class="group flex items-center gap-2.5 px-5 py-2.5
                      rounded-xl border border-dark/10 dark:border-surface/10
                      bg-white/60 dark:bg-surface/5
                      hover:border-primary/30 dark:hover:border-primary/30
                      hover:bg-primary/5 dark:hover:bg-primary/10
                      transition-all duration-300 cursor-default">
            <div
              class="w-2 h-2 rounded-full shrink-0 opacity-80 group-hover:opacity-100 transition-opacity"
              style={`background-color: ${tech.color}`}
            />
            <span class="text-sm font-semibold text-dark/70 dark:text-surface/70
                         group-hover:text-dark dark:group-hover:text-surface transition-colors">
              {tech.name}
            </span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .hero-gradient {
    background-color: #ffffff;
    background-image:
      radial-gradient(ellipse at 15% 40%, rgba(91, 77, 255, 0.12) 0px, transparent 55%),
      radial-gradient(ellipse at 85% 15%, rgba(47, 128, 237, 0.10) 0px, transparent 50%),
      radial-gradient(ellipse at 70% 85%, rgba(45, 212, 191, 0.09) 0px, transparent 50%);
  }

  :global(html.dark) .hero-gradient {
    background-color: #0D0F1A;
    background-image:
      radial-gradient(ellipse at 15% 40%, rgba(91, 77, 255, 0.25) 0px, transparent 55%),
      radial-gradient(ellipse at 85% 15%, rgba(47, 128, 237, 0.18) 0px, transparent 50%),
      radial-gradient(ellipse at 70% 85%, rgba(45, 212, 191, 0.15) 0px, transparent 50%);
  }

  .text-gradient {
    background: linear-gradient(135deg, #5B4DFF 0%, #2F80ED 50%, #2DD4BF 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
