---
// src/components/Hero.astro
import Button from "../ui/Button.astro";
import { translations } from "../i18n/translations";

// PASO 6: Lógica de detección de idioma
const lang = Astro.url.pathname.startsWith("/en") ? "en" : "es";
const t = translations[lang];

const techs = ["React", "Next.js", "Node.js", "Python", "AWS", "Blockchain"];
---

<section
  id="inicio"
  class="relative min-h-screen flex flex-col justify-center overflow-hidden py-20 hero-gradient"
>
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="flex flex-col items-start space-y-6">
        <span
          class="px-4 py-1.5 rounded-full bg-primary/10 text-primary text-sm font-bold tracking-wide uppercase border border-primary/20"
        >
          {t.hero.badge || "Engineering & Strategy"}
        </span>

        <h1
          class="text-5xl lg:text-7xl font-extrabold text-color-dark leading-tight tracking-tighter"
        >
          {t.hero.title}
        </h1>

        <p class="text-xl text-gray-600 max-w-xl">
          {t.hero.subtitle}
        </p>

        <div class="flex flex-wrap gap-4 pt-4">
          <Button href="/Proyectos">
            {t.hero.ctaPrimary}
          </Button>
          <Button href="/Proceso" variant="ghost">
            {t.hero.ctaSecondary}
          </Button>
        </div>
      </div>

      <div class="relative group">
        <div
          class="absolute -inset-1 bg-gradient-to-r from-primary/20 to-color-accent/20 rounded-3xl blur opacity-75 group-hover:opacity-100 transition duration-1000"
        >
        </div>

        <div
          class="relative bg-white/90 border border-gray-200 backdrop-blur-md rounded-3xl shadow-2xl p-8 space-y-8"
        >
          <div
            class="flex items-center space-x-2 border-b border-gray-100 pb-4"
          >
            <div class="flex space-x-1">
              <div class="w-3 h-3 rounded-full bg-red-400"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
            </div>
            <span class="text-xs font-mono text-gray-400 ml-4 italic"
              >system_optimization.exe</span
            >
          </div>

          <div class="space-y-6">
            {
              [92, 78, 85].map((value, i) => (
                <div class="space-y-2">
                  <div class="flex justify-between text-xs font-bold text-color-dark">
                    <span>METRIC_0{i + 1}</span>
                    <span>{value}%</span>
                  </div>
                  <div class="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
                    <div
                      class="bg-primary h-full rounded-full transition-all duration-1000 ease-out"
                      style={`width: ${value}%`}
                    />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="mt-24 pt-12 border-t border-gray-200/50">
      <p
        class="text-center text-sm font-semibold text-gray-400 uppercase tracking-[0.2em] mb-8"
      >
        Construido con tecnología de vanguardia
      </p>
      <div
        class="flex flex-wrap justify-center items-center gap-8 lg:gap-16 opacity-60 grayscale hover:grayscale-0 transition-all duration-500"
      >
        {
          techs.map((tech) => (
            <span class="text-lg font-bold text-color-dark hover:text-primary transition-colors cursor-default">
              {tech}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero-gradient {
    background-color: #f5f7fa;
    background-image:
      radial-gradient(at 0% 0%, rgba(91, 77, 255, 0.15) 0px, transparent 50%),
      radial-gradient(
        at 100% 100%,
        rgba(45, 212, 191, 0.12) 0px,
        transparent 50%
      );
  }

  .text-gradient {
    background: linear-gradient(to right, #5b4dff, #2dd4bf);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
