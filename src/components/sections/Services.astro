---
import { translations } from "../../i18n/translations";
const lang = Astro.url.pathname.startsWith("/en") ? "en" : "es";
const t = translations[lang];
const s = t.services;
---

<section id="servicios" class="py-24 bg-[#F5F7FA] dark:bg-[#111827] overflow-hidden">
  <div class="container mx-auto px-6">

    <!-- Encabezado -->
    <div class="reveal reveal-fade-up text-center mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full
                   bg-primary/10 border border-primary/20 text-primary text-sm font-semibold mb-4">
        {s.badge}
      </span>
      <h2 class="text-4xl lg:text-5xl font-extrabold text-dark dark:text-surface leading-tight mb-4">{s.title}</h2>
      <p class="text-lg text-dark/60 dark:text-surface/60 max-w-2xl mx-auto">{s.subtitle}</p>
    </div>

    <!-- Grid de servicios -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {s.items.map((item, i) => (
        <div
          class="reveal reveal-fade-up group p-7 rounded-2xl
                 bg-white dark:bg-white/4
                 border border-dark/8 dark:border-white/10
                 hover:border-primary/40 hover:-translate-y-1
                 hover:shadow-xl hover:shadow-primary/10
                 transition-all duration-300"
          data-delay={String(Math.min(i * 100, 400)) as any}
        >
          <div class="w-12 h-12 rounded-xl mb-5 flex items-center justify-center"
               style={`background:${item.color}18`}>
            <svg class="w-6 h-6" fill="none" stroke={item.color} viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-dark dark:text-surface mb-2">{item.title}</h3>
          <p class="text-sm text-dark/60 dark:text-surface/60 leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>

    <!-- Banner CTA -->
    <div class="reveal reveal-fade-up p-8 rounded-2xl
                bg-gradient-to-r from-primary/10 to-accent/10
                border border-primary/20
                flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <p class="font-bold text-dark dark:text-surface text-lg">{s.ctaBanner}</p>
        <p class="text-dark/60 dark:text-surface/60 text-sm">{s.ctaBannerSub}</p>
      </div>
      <a href="/contacto"
         class="shrink-0 px-6 py-3 rounded-xl bg-primary text-white font-bold text-sm
                hover:bg-primary/90 hover:-translate-y-0.5 shadow-lg shadow-primary/30
                transition-all duration-200">
        {s.ctaBannerBtn}
      </a>
    </div>
  </div>
</section>
