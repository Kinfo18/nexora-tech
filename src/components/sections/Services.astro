---
// src/components/sections/Services.astro
import Button from "../ui/Button.astro";
import { translations } from "../../i18n/translations";

const lang = Astro.url.pathname.startsWith("/en") ? "en" : "es";
const t = translations[lang];
const s = t.services;

// Íconos SVG para cada servicio (mismo orden que items en translations)
const icons = [
  // Software a Medida — código / terminal
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
  // Desarrollo Web — navegador
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>`,
  // Apps Móviles — smartphone
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`,
  // Consultoría Tech — bombilla
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
  // Automatización — engranajes
  `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
];
---

<section id="servicios" class="relative py-24 lg:py-32 bg-white dark:bg-deep overflow-hidden">

  <!-- Degradado decorativo de fondo -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px]
              bg-gradient-to-b from-primary/5 to-transparent
              rounded-full blur-3xl pointer-events-none">
  </div>

  <div class="relative container mx-auto px-6">

    <!-- ===== ENCABEZADO DE SECCIÓN ===== -->
    <div class="flex flex-col items-center text-center mb-16 space-y-5">

      <!-- Badge -->
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full
                   bg-primary/10 dark:bg-primary/15
                   border border-primary/20 dark:border-primary/30
                   text-primary text-sm font-semibold">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
        </svg>
        {s.badge}
      </span>

      <!-- Título -->
      <h2 class="text-4xl lg:text-5xl font-extrabold
                 text-dark dark:text-surface
                 leading-tight tracking-tight max-w-2xl">
        {s.title}
      </h2>

      <!-- Subtítulo -->
      <p class="text-lg text-dark/60 dark:text-surface/60 max-w-xl leading-relaxed">
        {s.subtitle}
      </p>

    </div>

    <!-- ===== GRID DE TARJETAS ===== -->
    <!--
      5 tarjetas en grid 3 columnas:
      Fila 1: 3 tarjetas completas
      Fila 2: 2 tarjetas centradas usando col-start trick
    -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {s.items.map((service, i) => (
        <div
          class="service-card group relative flex flex-col
                 rounded-2xl p-8
                 bg-white dark:bg-surface/5
                 border border-dark/10 dark:border-surface/10
                 shadow-sm
                 transition-all duration-300 ease-out
                 hover:-translate-y-1.5 hover:shadow-xl"
          style={`--service-color: ${service.color}`}
        >
          <!-- Borde iluminado en hover (pseudo-elemento via inline style) -->
          <div
            class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100
                   transition-opacity duration-300 pointer-events-none"
            style={`box-shadow: 0 0 0 2px ${service.color}40, 0 20px 40px -12px ${service.color}30`}
          ></div>

          <!-- Ícono con fondo del color del servicio -->
          <div
            class="w-14 h-14 rounded-xl flex items-center justify-center mb-6
                   transition-transform duration-300 group-hover:scale-110"
            style={`background-color: ${service.color}18; color: ${service.color}`}
          >
            <Fragment set:html={icons[i]} />
          </div>

          <!-- Título del servicio -->
          <h3 class="text-xl font-bold text-dark dark:text-surface mb-3
                     group-hover:text-[var(--service-color)] transition-colors duration-300">
            {service.title}
          </h3>

          <!-- Descripción -->
          <p class="text-base text-dark/60 dark:text-surface/60 leading-relaxed flex-1">
            {service.description}
          </p>

          <!-- Link inferior -->
          <div class="flex items-center gap-1.5 mt-6 text-sm font-semibold
                      text-dark/40 dark:text-surface/40
                      group-hover:text-[var(--service-color)]
                      transition-colors duration-300">
            <span>{lang === "es" ? "Saber más" : "Learn more"}</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </div>

        </div>
      ))}
    </div>

    <!-- ===== BANNER CTA ===== -->
    <div class="mt-16 rounded-2xl
                bg-gradient-to-r from-primary/8 via-secondary/8 to-accent/8
                dark:from-primary/15 dark:via-secondary/12 dark:to-accent/10
                border border-primary/15 dark:border-primary/20
                px-8 py-10
                flex flex-col md:flex-row items-center justify-between gap-6">

      <div class="text-center md:text-left">
        <p class="text-xl font-bold text-dark dark:text-surface">
          {s.ctaBanner}
        </p>
        <p class="text-base text-dark/60 dark:text-surface/60 mt-1">
          {s.ctaBannerSub}
        </p>
      </div>

      <div class="shrink-0">
        <Button href="/#contacto">{s.ctaBannerBtn}</Button>
      </div>

    </div>

  </div>
</section>
