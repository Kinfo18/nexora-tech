---
// src/components/sections/Projects.astro
import { translations } from "../../i18n/translations";

const lang = Astro.url.pathname.startsWith("/en") ? "en" : "es";
const t = translations[lang];
const p = t.projects;
---

<section id="proyectos" class="relative py-24 lg:py-32 bg-white dark:bg-deep overflow-hidden">

  <!-- Degradado decorativo superior -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px]
              bg-gradient-to-bl from-accent/6 to-transparent
              rounded-full blur-3xl pointer-events-none">
  </div>

  <div class="relative container mx-auto px-6">

    <!-- ===== ENCABEZADO ===== -->
    <div class="flex flex-col items-center text-center mb-12 space-y-5">

      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full
                   bg-accent/10 dark:bg-accent/15
                   border border-accent/20 dark:border-accent/30
                   text-accent text-sm font-semibold">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
        {p.badge}
      </span>

      <h2 class="text-4xl lg:text-5xl font-extrabold
                 text-dark dark:text-surface
                 leading-tight tracking-tight max-w-2xl">
        {p.title}
      </h2>

      <p class="text-lg text-dark/60 dark:text-surface/60 max-w-xl leading-relaxed">
        {p.subtitle}
      </p>

    </div>

    <!-- ===== FILTROS ===== -->
    <div class="flex flex-wrap justify-center gap-3 mb-12" id="project-filters">
      {Object.entries(p.filters).map(([key, label]) => (
        <button
          data-filter={key}
          class={`filter-btn px-5 py-2 rounded-full text-sm font-semibold
                  border transition-all duration-200
                  ${ key === "all"
                    ? "bg-primary text-white border-primary shadow-md shadow-primary/25"
                    : "bg-transparent text-dark/60 dark:text-surface/60 border-dark/15 dark:border-surface/15 hover:border-primary/40 hover:text-primary dark:hover:text-primary"
                  }`}
        >
          {label}
        </button>
      ))}
    </div>

    <!-- ===== GRID DE PROYECTOS ===== -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7" id="projects-grid">
      {p.items.map((project) => (
        <div
          class="project-card group relative rounded-2xl overflow-hidden
                 bg-white dark:bg-surface/5
                 border border-dark/10 dark:border-surface/10
                 shadow-sm hover:shadow-xl
                 transition-all duration-300"
          data-category={project.category}
        >

          <!-- IMAGEN / MOCKUP GENERADO CON CSS -->
          <div class="relative h-52 overflow-hidden">

            <!-- Fondo con gradiente del proyecto -->
            <div class={`absolute inset-0 bg-gradient-to-br ${project.gradient} opacity-90`}></div>

            <!-- Patrón de puntos decorativo sobre el gradiente -->
            <div class="absolute inset-0 opacity-20"
                 style="background-image: radial-gradient(circle, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 20px 20px;">
            </div>

            <!-- Mockup de ventana minimalista -->
            <div class="absolute inset-4 rounded-xl bg-white/15 backdrop-blur-sm
                        border border-white/25 flex flex-col overflow-hidden">
              <!-- Barra superior mockup -->
              <div class="flex items-center gap-1.5 px-3 py-2 bg-white/10">
                <div class="w-2 h-2 rounded-full bg-white/60"></div>
                <div class="w-2 h-2 rounded-full bg-white/60"></div>
                <div class="w-2 h-2 rounded-full bg-white/60"></div>
                <div class="ml-2 flex-1 h-1.5 rounded-full bg-white/20"></div>
              </div>
              <!-- Contenido mockup abstracto -->
              <div class="flex-1 p-3 space-y-2">
                <div class="h-2 rounded-full bg-white/30 w-3/4"></div>
                <div class="h-2 rounded-full bg-white/20 w-1/2"></div>
                <div class="mt-3 grid grid-cols-3 gap-2">
                  <div class="h-10 rounded-lg bg-white/20"></div>
                  <div class="h-10 rounded-lg bg-white/15"></div>
                  <div class="h-10 rounded-lg bg-white/20"></div>
                </div>
                <div class="h-2 rounded-full bg-white/20 w-5/6"></div>
                <div class="h-2 rounded-full bg-white/15 w-2/3"></div>
              </div>
            </div>

            <!-- Etiqueta de industria -->
            <div class="absolute top-3 right-3">
              <span class="px-2.5 py-1 rounded-full bg-white/20 backdrop-blur-sm
                           text-white text-xs font-semibold">
                {project.industry}
              </span>
            </div>

            <!-- OVERLAY en hover -->
            <div class="absolute inset-0 bg-deep/85 backdrop-blur-sm
                        opacity-0 group-hover:opacity-100
                        transition-all duration-300
                        flex flex-col items-center justify-center gap-4 p-6">
              <p class="text-surface/90 text-sm text-center leading-relaxed">
                {project.description}
              </p>
              <span
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl
                       bg-white/15 hover:bg-white/25
                       text-white text-sm font-semibold
                       border border-white/20
                       transition-all duration-200 cursor-pointer">
                {p.viewProject}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </span>
            </div>

          </div>

          <!-- INFO DE LA TARJETA -->
          <div class="p-6">

            <!-- Nombre del proyecto -->
            <h3 class="text-lg font-bold text-dark dark:text-surface mb-1">
              {project.name}
            </h3>

            <!-- Tags de tecnologías -->
            <div class="flex flex-wrap gap-2 mt-3">
              {project.tags.map((tag) => (
                <span
                  class="px-2.5 py-0.5 rounded-full text-xs font-semibold
                         bg-dark/6 dark:bg-surface/10
                         text-dark/60 dark:text-surface/60"
                >
                  {tag}
                </span>
              ))}
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Filtrado interactivo de proyectos
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const projectCards = document.querySelectorAll<HTMLElement>(".project-card");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;

      // Actualizar estilos de los botones
      filterBtns.forEach((b) => {
        b.classList.remove("bg-primary", "text-white", "border-primary", "shadow-md", "shadow-primary/25");
        b.classList.add("bg-transparent", "text-dark/60", "dark:text-surface/60", "border-dark/15");
      });
      btn.classList.add("bg-primary", "text-white", "border-primary", "shadow-md", "shadow-primary/25");
      btn.classList.remove("bg-transparent", "text-dark/60", "border-dark/15");

      // Filtrar tarjetas con animación
      projectCards.forEach((card) => {
        const category = card.dataset.category;
        const show = filter === "all" || category === filter;

        if (show) {
          card.style.display = "block";
          // Pequeña animación de entrada
          card.style.opacity = "0";
          card.style.transform = "translateY(8px)";
          requestAnimationFrame(() => {
            card.style.transition = "opacity 0.3s ease, transform 0.3s ease";
            card.style.opacity = "1";
            card.style.transform = "translateY(0)";
          });
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>
