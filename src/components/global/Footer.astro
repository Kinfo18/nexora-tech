---
// src/components/global/Footer.astro
import { translations } from "../../i18n/translations";

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith("/en") ? "en" : "es";
const t = translations[lang];
const prefix = lang === "en" ? "/en" : "";

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: "X (Twitter)",
    href: "https://x.com",
    icon: `<svg fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.261 5.632 5.903-5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    name: "Facebook",
    href: "https://facebook.com",
    icon: `<svg fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  },
  {
    name: "Instagram",
    href: "https://instagram.com",
    icon: `<svg fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
];

const footerLinks = {
  services: [
    {
      name: lang === "es" ? "Software a Medida" : "Custom Software",
      href: `${prefix}/#servicios`,
    },
    {
      name: lang === "es" ? "Desarrollo Web" : "Web Development",
      href: `${prefix}/#servicios`,
    },
    {
      name: lang === "es" ? "Apps Móviles" : "Mobile Apps",
      href: `${prefix}/#servicios`,
    },
    {
      name: lang === "es" ? "Consultoría Tech" : "Tech Consulting",
      href: `${prefix}/#servicios`,
    },
  ],
  company: [
    {
      name: lang === "es" ? "Sobre Nosotros" : "About Us",
      href: `${prefix}/#nosotros`,
    },
    {
      name: lang === "es" ? "Proyectos" : "Projects",
      href: `${prefix}/#proyectos`,
    },
    {
      name: lang === "es" ? "Tecnologías" : "Technologies",
      href: `${prefix}/#tecnologias`,
    },
    {
      name: lang === "es" ? "Contacto" : "Contact",
      href: `${prefix}/contacto`,
    },
  ],
};
---

<footer
  class="bg-surface dark:bg-deep border-t border-dark/10 dark:border-surface/10"
>
  <!-- Sección principal del footer -->
  <div class="container mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Columna 1: Logo + descripción + redes sociales -->
      <div class="lg:col-span-1">
        <a href={`${prefix}/`} aria-label="Nexora Technologies">
          <img
            src="/images/logo-horizontal.png"
            alt="Nexora Technologies"
            class="h-9 w-auto mb-4"
          />
        </a>
        <p
          class="text-sm text-dark/60 dark:text-surface/60 leading-relaxed mb-6"
        >
          {
            lang === "es"
              ? "Transformamos ideas en soluciones digitales para empresas que buscan crecer."
              : "We transform ideas into digital solutions for companies looking to grow."
          }
        </p>
        <!-- Redes sociales -->
        <div class="flex items-center gap-3">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                class="w-9 h-9 flex items-center justify-center rounded-lg
                     text-dark/50 dark:text-surface/50
                     hover:text-primary dark:hover:text-primary
                     hover:bg-primary/10 dark:hover:bg-primary/10
                     transition-colors duration-200"
                set:html={social.icon}
              />
            ))
          }
        </div>
      </div>

      <!-- Columna 2: Servicios -->
      <div>
        <h3
          class="text-sm font-semibold text-dark dark:text-surface uppercase tracking-wider mb-4"
        >
          {lang === "es" ? "Servicios" : "Services"}
        </h3>
        <ul class="flex flex-col gap-2.5">
          {
            footerLinks.services.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-dark/60 dark:text-surface/60
                       hover:text-primary dark:hover:text-primary
                       transition-colors duration-200"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 3: Empresa -->
      <div>
        <h3
          class="text-sm font-semibold text-dark dark:text-surface uppercase tracking-wider mb-4"
        >
          {lang === "es" ? "Empresa" : "Company"}
        </h3>
        <ul class="flex flex-col gap-2.5">
          {
            footerLinks.company.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-dark/60 dark:text-surface/60
                       hover:text-primary dark:hover:text-primary
                       transition-colors duration-200"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 4: Contacto -->
      <div>
        <h3
          class="text-sm font-semibold text-dark dark:text-surface uppercase tracking-wider mb-4"
        >
          {lang === "es" ? "Contacto" : "Contact"}
        </h3>
        <ul class="flex flex-col gap-3">
          <li
            class="flex items-start gap-2.5 text-sm text-dark/60 dark:text-surface/60"
          >
            <svg
              class="w-4 h-4 mt-0.5 text-primary shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            contacto@nexora.tech
          </li>
          <li
            class="flex items-start gap-2.5 text-sm text-dark/60 dark:text-surface/60"
          >
            <svg
              class="w-4 h-4 mt-0.5 text-primary shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            +57 300 000 0000
          </li>
          <li
            class="flex items-start gap-2.5 text-sm text-dark/60 dark:text-surface/60"
          >
            <svg
              class="w-4 h-4 mt-0.5 text-primary shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Bogotá, Colombia
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Barra inferior de copyright -->
  <div class="border-t border-dark/10 dark:border-surface/10">
    <div
      class="container mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-3"
    >
      <p class="text-xs text-dark/50 dark:text-surface/50">
        © {currentYear} Nexora Technologies.
        {
          lang === "es"
            ? "Todos los derechos reservados."
            : "All rights reserved."
        }
      </p>
      <p class="text-xs text-dark/40 dark:text-surface/40">
        {
          lang === "es"
            ? "Hecho con ❤️ en Bogotá, Colombia"
            : "Made with ❤️ in Bogotá, Colombia"
        }
      </p>
    </div>
  </div>
</footer>
