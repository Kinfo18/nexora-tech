---
// src/components/global/ThemeToggle.astro
// Switch iOS para alternar entre modo claro y oscuro
// Guarda la preferencia en localStorage para persistir entre visitas
---

<button
  id="theme-toggle"
  aria-label="Cambiar tema"
  title="Cambiar entre modo claro y oscuro"
  class="relative inline-flex h-6 w-11 items-center rounded-full
         bg-surface border border-dark/20
         dark:bg-deep dark:border-surface/20
         transition-colors duration-300 cursor-pointer
         focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
>
  <!-- Círculo deslizante del switch -->
  <span
    id="theme-toggle-thumb"
    class="absolute left-0.5 flex h-5 w-5 items-center justify-center
           rounded-full bg-white shadow-sm
           transition-transform duration-300
           dark:translate-x-5"
  >
    <!-- Ícono sol (visible en modo claro) -->
    <svg
      class="h-3 w-3 text-highlight block dark:hidden"
      fill="currentColor"
      viewBox="0 0 20 20"
    >
      <path
        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 1.78a1 1 0 011.42 1.42l-.7.7a1 1 0 11-1.42-1.42l.7-.7zM18 9a1 1 0 110 2h-1a1 1 0 110-2h1zM4.22 15.78a1 1 0 001.42-1.42l-.7-.7a1 1 0 00-1.42 1.42l.7.7zM10 16a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM3.78 4.22a1 1 0 00-1.42 1.42l.7.7a1 1 0 001.42-1.42l-.7-.7zM2 11a1 1 0 110-2H1a1 1 0 110 2h1zM15.78 15.78a1 1 0 01-1.42-1.42l.7-.7a1 1 0 011.42 1.42l-.7.7zM10 6a4 4 0 100 8 4 4 0 000-8z"
      ></path>
    </svg>
    <!-- Ícono luna (visible en modo oscuro) -->
    <svg
      class="h-3 w-3 text-primary hidden dark:block"
      fill="currentColor"
      viewBox="0 0 20 20"
    >
      <path
        d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
      ></path>
    </svg>
  </span>
</button>

<script>
  // Este script corre en el NAVEGADOR (no en el servidor)
  // Se encarga de escuchar el clic y cambiar el tema
  const toggle = document.getElementById("theme-toggle");

  toggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    // Guardamos la preferencia para que persista al recargar
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
