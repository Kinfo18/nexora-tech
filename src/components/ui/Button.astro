---
// src/components/ui/Button.astro
// Componente de botón reutilizable con variantes del brand kit de Nexora

interface Props {
  href: string;
  variant?: "primary" | "ghost";
  target?: "_blank" | "_self"; // Para abrir en nueva pestaña si es necesario
  class?: string; // Permite agregar clases extra desde afuera
}

const {
  href,
  variant = "primary",
  target = "_self",
  class: extraClasses = "",
} = Astro.props;

// Clases compartidas por TODAS las variantes
const baseClasses =
  "inline-flex items-center justify-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold transition-all duration-300 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2";

// Clases específicas por variante — usando SIEMPRE colores del brand kit
const variants = {
  primary:
    // Fondo violeta → hover más oscuro con escala sutil
    "bg-primary text-white hover:bg-primary/85 hover:scale-[1.02] active:scale-[0.98] shadow-sm shadow-primary/30",

  ghost:
    // Transparente con borde violeta → hover con fondo suave
    // dark: el texto cambia para verse sobre fondos oscuros
    "bg-transparent text-primary border border-primary hover:bg-primary/10 dark:text-primary dark:border-primary dark:hover:bg-primary/15",
};
---

<a
  href={href}
  target={target}
  class={`${baseClasses} ${variants[variant]} ${extraClasses}`}
>
  <slot />
</a>
